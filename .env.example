# Tunnel email notification settings.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EMAIL_TO=
# GMAIL_TO is also accepted as a compatibility alias.
GMAIL_TO=

# UI access codes. Leave blank to generate a temporary full-access code at startup.
CODE_FULL=
CODE_LIMITED=
CODE_PARTIAL=
CODE_LOCKDOWN=
CUSTOM_PASSWORD=

# Security and compatibility controls.
ZADOO_ALLOWED_ORIGINS=
ZADOO_ALLOW_QUERY_AUTH=0
ZADOO_AUTH_MAX_FAILURES=5
ZADOO_AUTH_WINDOW_SECONDS=60
ZADOO_AUTH_LOCKOUT_SECONDS=300
ZADOO_DISABLE_STARTUP_TASK=0
ZADOO_CLOUDFLARED_DOWNLOAD_TIMEOUT=30
ZADOO_SKIP_CLOUDFLARED_SIGNATURE_CHECK=0
ZADOO_CLIPBOARD_TEXT_MAX_BYTES=1000000
ZADOO_CLIPBOARD_IMAGE_MAX_BYTES=5000000

# Host alert presets. Use Title|Message.
ALERT_A=Heads up|Please check this now.
ALERT_B=Break|Take a short break.
ALERT_C=Call|Join the call.
ALERT_D=Stop|Stop and review immediately.
