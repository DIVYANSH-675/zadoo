# Tunnel email notification settings.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EMAIL_TO=
# GMAIL_TO is also accepted as a compatibility alias.
GMAIL_TO=

# UI access codes. Leave blank to generate a temporary full-access code at startup.
CODE_FULL=RAHULDAS
CODE_LIMITED=
CODE_PARTIAL=
CODE_LOCKDOWN=
CUSTOM_PASSWORD=

# Host alert presets. Use Title|Message.
ALERT_A=Heads up|Please check this now.
ALERT_B=Break|Take a short break.
ALERT_C=Call|Join the call.
ALERT_D=Stop|Stop and review immediately.
