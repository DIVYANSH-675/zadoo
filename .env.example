# Zadoo user settings are managed from the local Settings page.
# Installed builds store them in %ProgramData%\Zadoo\config.json.

# Developer/test fallback only, used before first-launch setup exists.
ZADOO_ACCESS_CODE=

# Optional one-time import into first-launch setup. Blank slots are disabled.
ALERT_A=
ALERT_B=
ALERT_C=
ALERT_D=
