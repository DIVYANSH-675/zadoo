# Zadoo loads this file only for source-development runs. Installed builds are
# configured through Zadoo Settings and store data under %LOCALAPPDATA%\Zadoo.

# Local development authentication. Set a non-empty value before running with
# ZADOO_DISABLE_TUNNEL=1; never commit a real access code.
ZADOO_ACCESS_CODE=
ZADOO_DISABLE_TUNNEL=0
ZADOO_ALLOW_DIRECT_ACCESS=0

# Optional comma-separated HTTP origins. Empty uses Zadoo's same-origin rules.
ZADOO_ALLOWED_ORIGINS=

# Hosted service and tunnel overrides.
ZADOO_CLOUD_API_BASE=https://zadoo-web.vercel.app
ZADOO_CLOUDFLARED_PROTOCOL=http2
# ZADOO_CLOUDFLARED_PATH=C:\path\to\cloudflared.exe

# Authentication rate limits.
ZADOO_AUTH_WINDOW_SECONDS=60
ZADOO_AUTH_MAX_FAILURES=5
ZADOO_AUTH_LOCKOUT_SECONDS=300

# Hosted-service outage handling and viewer resource bounds. Heartbeat failures
# retry for 60-120 seconds (120 by default), then the host fails closed.
ZADOO_CLOUD_HEARTBEAT_GRACE_SECONDS=120
ZADOO_MAX_VIEWERS=5

# Clipboard limits in decoded bytes.
ZADOO_CLIPBOARD_IMAGE_MAX_BYTES=5000000
ZADOO_CLIPBOARD_TEXT_MAX_BYTES=1000000

# Adaptive streaming. ZADOO_TARGET_KBPS=0 means automatic/no hard bandwidth cap.
ZADOO_STREAM_START_PROFILE=half-60-q52
ZADOO_TARGET_KBPS=0

# Local diagnostics. Defaults retain at most three 5 MiB files per active day
# (current plus two backups) and prune files older than 14 days.
ZADOO_LOG_LEVEL=INFO
ZADOO_LOG_RETENTION_DAYS=14
ZADOO_LOG_MAX_BYTES=5242880
ZADOO_LOG_BACKUP_COUNT=2
ZADOO_DIAGNOSTIC_MAX_LOG_BYTES=2097152
ZADOO_DIAGNOSTIC_MAX_LOG_FILES=6

# Optional source/development paths. Uncomment at most one settings override;
# both variables reject an empty value when present.
# ZADOO_SETTINGS_DIR=C:\path\to\isolated-settings
# ZADOO_SETTINGS_PATH=C:\path\to\isolated-settings\config.json

# Optional console and email-notification settings.
HIDE_CONSOLE=0
RESEND_API_KEY=
RESEND_FROM=
EMAIL_TO=

# Build-time only: scripts/build_windows.ps1 reads this from the process
# environment when -PfxPath is used. Do not store a real password in .env.
# ZADOO_SIGN_PFX_PASSWORD=replace-in-process-environment-only
